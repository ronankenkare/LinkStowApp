        "properties": {
          "origin": "manual",
          "rationale": "SUPPORTS PLATFORM DECLARATION: Provides NSFaceIDUsageDescription text if the OS uses Face ID for the deviceOwnerAuthentication policy. Policy also supports passcode; this string grants no authorization.",
          "targetFingerprint": "[\"document-requirement\",\"REQ-007 Guard selected hidden-link UI transitions\",{\"key\":\"REQ-007\",\"title\":\"Guard selected hidden-link UI transitions\",\"statement\":\"Enabling Hidden Group, entering the hidden filter, and changing the editor to hidden shall invoke LocalAuthentication deviceOwnerAuthentication. Failure or unavailable policy shall not authorize the transition. Unhide and disable do not require auth. UI guards do not authorize model/controller operations. Status: as implemented, not an approved future requirement.\"}]"
        },
