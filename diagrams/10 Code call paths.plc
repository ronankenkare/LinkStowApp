      {
        "id": "note-a7e0da1d-bdc5-441f-bf84-728980244d88",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Code-level save path. Calls are shown in source order; routine synchronous returns are omitted. alt branches are mutually exclusive. Exact caller/callee source spans are linked to the messages. Broader capture/authentication/QR connections are traced directly between code parts.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:10:58.106Z",
        "modifiedAt": "2026-10-28T18:16:29.011Z"
      },
      {
        "id": "note-94872808-7fc3-4678-ab2e-a0ec27804f95",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "ModelContext is an external platform service. New links are inserted and rely on autosave; existing links call try? save(). The hidden/group invariant is applied in LinkModel.updateLink. This is a manually inspected static path, not runtime profiling or a compiler-generated call graph.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:10:58.106Z",
        "modifiedAt": "2026-10-28T18:16:29.011Z"
      }
    ],
