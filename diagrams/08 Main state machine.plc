      {
        "id": "note-f384e331-194e-4cbb-ad55-348b7147d0d6",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "filterLink is declared but unreachable: no setter assigns it. Text filtering requires that state and is dormant (GAP-001). All/group/hidden filtering uses separate flags. changeFilterState resets capture fields and sort direction; resetMainController(true) does not enter filterLink.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:46:31.376Z",
        "modifiedAt": "2026-10-28T18:14:13.810Z"
      },
      {
        "id": "note-0f14f2ad-9ed6-43b8-a65a-43edc9fedf0c",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "No explicit loading state, cancellation token, or request-generation guard exists for async verification/metadata. Results can arrive after input changes. The editor is a sheet outside MainButtonState; capture resets before it opens.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:46:31.376Z",
        "modifiedAt": "2026-10-28T18:14:13.810Z"
      }
    ],
