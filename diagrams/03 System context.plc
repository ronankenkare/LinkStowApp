      {
        "id": "note-e31fac0c-0eb3-490b-9fcf-ced52bbfd8fb",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "As implemented: iOS/UIKit application. Library storage is local; metadata retrieval contacts remote sites. Reminder fields exist, but no notification service is operational. Hidden links use UI gating, not app-level encryption.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:42:49.561Z",
        "modifiedAt": "2026-10-28T18:50:48.545Z"
      },
      {
        "id": "note-1eaabcb3-3861-45a0-a0ef-3231e99535a7",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Build inputs: base Info.plist and entitlements are empty. project.pbxproj supplies generated runtime keys and selects those inputs. Device-owner authentication is UI gating; the empty entitlements file grants no extra capability.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:50:48.545Z",
        "modifiedAt": "2026-10-28T18:50:48.545Z"
      },
      {
        "id": "note-4b76602b-ef97-4058-92e0-dd2d694d04b8",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "LaunchScreen.storyboard is not selected by effective Debug launch settings or declared Release settings. It references missing linkStack_icon. Trace its real DefaultAppColor reference as an unselected resource; do not read it as the active launch UI.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:50:48.545Z",
        "modifiedAt": "2026-10-28T18:50:48.545Z"
      }
