      {
        "id": "note-b9bca603-5057-4266-a18f-246f74ce5b10",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Same project classifiers as the code view, not copies. Group membership is many-to-many with inverse and nullify deletion. No cascade rule is declared for symbol references. updateLink clears groups for hidden records; toggleHideLink/direct mutation bypass this rule.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:45:32.252Z",
        "modifiedAt": "2026-10-28T18:14:13.442Z"
      },
      {
        "id": "note-c2628fe4-f575-4247-8bae-8451c20278bf",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Reminder fields store intent only; disabling clears date/all-day. The editor passes its time toggle into reminderAllDay (known mapping mismatch). LinkModel.linkService is @Transient. SymbolModel is reached through persistent relationships although the explicit schema lists LinkModel and GroupModel.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:45:32.252Z",
        "modifiedAt": "2026-10-28T18:14:13.442Z"
      }
