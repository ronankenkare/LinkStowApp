      {
        "id": "note-5411066d-a65a-4303-8289-40dd98f8fc34",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "New link path: createLink does not insert. Saving calls the view model and controller; insertion relies on SwiftData autosave. Existing edits instead call updateLink and try? save(). Metadata errors become empty/nil values. Cancel dismisses an uninserted draft. No notification is scheduled.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:42:50.156Z",
        "modifiedAt": "2026-10-28T18:14:13.066Z"
      },
      {
        "id": "note-206bad0d-56a1-43e2-85af-afb6737a7e13",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Reminder fields and control definitions exist, but reminderSection is commented out of LinkEditorView.body. Reminder editing is not part of the currently rendered form and notification scheduling is not implemented.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:14:10.703Z",
        "modifiedAt": "2026-10-28T18:14:13.066Z"
      }
    ],
