      {
        "id": "note-69c1d186-5046-46aa-8ea7-20819c0d67b8",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Logical responsibilities within one app process, not independent services. MainView and MainController span responsibilities. Refines traces link each subsystem to LinkStow; satisfies traces allocate the current system requirements.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:42:49.763Z",
        "modifiedAt": "2026-10-28T18:53:32.986Z"
      },
      {
        "id": "note-55ea0fab-b067-4f23-911e-b15e9a7c30fa",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Configuration/resource traces distinguish runtime calls from named asset lookups, build inputs, SwiftSoup pinning and test workflow. FilterButton is dormant; LinkSilver/CancelEditButton/UpdateButton are unreferenced; README branding is documentation-only.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T18:50:49.904Z",
        "modifiedAt": "2026-10-28T18:53:32.986Z"
      }
