      },
      {
        "id": "note-5c818208-78f9-4a41-a111-d82177099b53",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "Boxes are source-level symbols. A file can serve multiple logical subsystems; traces record these allocations. UserDefaults helpers are tested but production screens bind the same keys directly via AppStorage. Authentication is not enforced by MainController or SwiftData.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:42:49.953Z",
        "modifiedAt": "2026-10-28T18:14:12.689Z"
      },
      {
        "id": "note-f9862e6b-e022-4d3e-a8cf-9b34c64c623a",
        "kind": "note",
        "ownerId": null,
        "name": "",
        "documentation": "UserDefaults extension is a tested helper and is not called by production views, which use AppStorage directly. Its isolation is intentional. GroupEditorView opens from LinkEditorView. QRCodeView.swift also defines the shared ShareSheet wrapper.",
        "properties": {
          "targetKind": "diagram",
          "targetId": null
        },
        "createdAt": "2026-10-28T17:53:15.777Z",
        "modifiedAt": "2026-10-28T18:14:12.689Z"
      }
    ],
